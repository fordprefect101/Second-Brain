# ---- Secrets (see docs/decisions/ADR-006 and Plan.md §22) ----
# Nothing resembling a credential may ever be committed.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
client_secret*.json
token*.json

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ---- Node ----
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---- Local data ----
# The local DB is a cache/index, never a source of truth. It is rebuildable
# and machine-specific, so it is never committed.
*.db
*.sqlite3
pgdata/
.local/

# ---- Docs kept local, not published ----
# Design notes, ADRs, the learning log, and the project brief stay on this machine.
# README.md is the only published markdown. The leading slash anchors the exception
# to the repo root, so nested README.md files (docs/decisions/README.md and friends)
# stay ignored too.
*.md
!/README.md

# ---- Editor / OS ----
.DS_Store
.vscode/
.idea/
.cursor/
