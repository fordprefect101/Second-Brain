# Copy to .env and fill in. .env is gitignored and must never be committed (Plan.md §22).
#
#   cp .env.example .env
#
# NOTE: OAuth tokens do NOT belong in this file. From Phase 3 onward, refresh tokens
# are long-lived credentials to your entire digital life and go in the macOS Keychain
# via `keyring`. This file holds local infrastructure config only.

# --- Postgres container (docker-compose.yml) ---
POSTGRES_USER=personalos
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=personalos
POSTGRES_PORT=5433

# --- API connection string ---
# Must match the values above.
DATABASE_URL=postgresql://personalos:replace-with-a-local-password@localhost:5433/personalos
